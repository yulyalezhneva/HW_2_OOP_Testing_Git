class Recipe:
    def __init__(self, title: str, ingridients: list[Ingridient]):
        self.title = title
        self.ingridients = ingridients

    def add_ingredient(ingridient: Ingridient):
        for n in self.ingridients:
            if n = ingridient: 
                n.quantity += ingridient.quantity
            return 
        self.ingridients.append(ingridient)

    @staticmethod
    def is_valid_ratio(ratio):
        if ratio>0:
            return True
        else:
            return False
        
    def scale(ratio: float):
        a=[]
        for i in self.ingridients:
            new = Ingridient(i.name, i.quantity*ratio, i.unit)
            a.append(new)
        return Recipe(self.title, a)
    
    def __len__(self):
        return len(self.ingridients)
    
    def __str__(self):
        return f"{self.title}: {self.ingridients}"
    

    
