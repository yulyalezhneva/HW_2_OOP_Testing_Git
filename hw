class Ingridient:
    def __init__(self, name: str, quantity: float, unit: str):
        self.name = name
        self._quantity = quantity
        self.unit = unit

    @property
    def quantity(self):
        return self._quantity
    
    @quantity.setter
    def quantity(self, value):
        if value<=0:
            raise ValueError('Кол-во должно быть положительным!')
        self._quantity = float(value)

